# ICAI Nagpur frontend env. Copy to .env.local for dev; CI/build pulls
# real values from the deployment platform. Vite only exposes vars
# prefixed VITE_ to the browser bundle.

# reCAPTCHA v3 — paired with backend RECAPTCHA_SECRET_KEY.
# Get a free pair at https://www.google.com/recaptcha/admin
# Leave blank in dev; the contact form will skip captcha when empty.
VITE_RECAPTCHA_SITE_KEY=
